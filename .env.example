# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret for signing session cookies (staff auth).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-hex-string"

# Restart command for the in-admin self-update (admin → «Обновления»).
# After git pull + build the app runs this command (detached) and exits.
#   - with a supervisor:  RESTART_CMD="pm2 restart school-library"
#                         RESTART_CMD="systemctl restart school-library"
#   - without one:        RESTART_CMD="bash scripts/restart-server.sh"
# If unset, the process just exits and expects a supervisor to restart it.
RESTART_CMD=""

# Separate key for the *reversible* copy of pupil passwords (users.password_enc,
# shown in the pupil cabinet). Optional but recommended: without it the key is
# derived from SESSION_SECRET, so one leaked env file means both forged sessions
# and readable passwords - and rotating SESSION_SECRET makes stored passwords
# unreadable. Rows encrypted before this key existed keep working (they are
# stored unprefixed); new ones are tagged "k2:".
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_ENC_KEY=""

# Set to 1 only when a reverse proxy (nginx) stands in front of the app and
# rewrites X-Forwarded-For. Login rate limiting keys attempts by IP only then -
# otherwise anyone could reset the counters by spoofing the header. Without a
# trusted proxy the limiter keys by login name (and by a shared, softer bucket
# for QR / invite token probing).
TRUST_PROXY=""
